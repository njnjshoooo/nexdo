# =====================================================================
# Supabase 後端（必填）
# =====================================================================
# 前端用：anon key 走 RLS、寫入需 auth
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Serverless 用：service role 繞過 RLS 寫訂單狀態（綠界 callback 需要）
# ⚠️ 絕對不能加 VITE_ 前綴，否則會被打包進前端
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# =====================================================================
# 綠界 ECPay 金流（必填）
# =====================================================================
# 測試環境用以下三組（公開測試金鑰，可直接用）：
#   ECPAY_MERCHANT_ID=2000132
#   ECPAY_HASH_KEY=5294y06JbISpM5x9
#   ECPAY_HASH_IV=v77hoKGq4kWxNNIS
#   ECPAY_API_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5
# 正式環境改用商家後台拿到的金鑰，API_URL 去掉 -stage
ECPAY_MERCHANT_ID=""
ECPAY_HASH_KEY=""
ECPAY_HASH_IV=""
ECPAY_API_URL="https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5"

# =====================================================================
# Resend 通知信（必填）
# =====================================================================
RESEND_API_KEY=""
# 寄件人 email，需在 Resend 後台驗證網域；建議 noreply@nexdo.tw
RESEND_FROM_EMAIL="noreply@nexdo.tw"
# 商家內部通知收件人（多個用逗號分隔）
INTERNAL_NOTIFICATION_EMAIL="admin@nexdo.tw"
# 客服聯絡頁，放在通知信底部的「請勿回覆」提示；不設則用 SITE_URL
PUBLIC_CONTACT_URL="https://www.nexdo.tw"

# =====================================================================
# 站點 URL（必填）
# =====================================================================
# 正式：https://www.nexdo.tw（callback 與通知信連結會用這個）
# 本機：http://localhost:3000
PUBLIC_SITE_URL="https://www.nexdo.tw"

# =====================================================================
# 其他
# =====================================================================
# Gemini AI API（選填，僅部分功能需要）
GEMINI_API_KEY="MY_GEMINI_API_KEY"
-e 
# =====================================================================
# Google Analytics 4 (GA4)
# =====================================================================
VITE_GA_MEASUREMENT_ID=""

